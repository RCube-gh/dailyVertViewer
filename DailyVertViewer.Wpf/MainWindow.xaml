<Window x:Class="DailyVertViewer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:DailyVertViewer.Wpf.Converters"
        xmlns:models="clr-namespace:DailyVertViewer.Wpf.Models"
        mc:Ignorable="d"
        Title="dailyVertViewer"
        Width="500"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="True">
    <Window.Resources>
        <conv:EnumEqualsToVisibilityConverter x:Key="EnumEqualsToVisibilityConverter" />
        <conv:StringHasValueToVisibilityConverter x:Key="StringHasValueToVisibilityConverter" />
    </Window.Resources>
    <Grid Background="Transparent">
        <Border CornerRadius="12" Background="#FF1E1E1E" BorderBrush="#22000000" BorderThickness="1">
            <Grid>
                <Grid Visibility="{Binding IsCalendarVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FF161616" />
                    <Canvas Grid.Column="0" IsHitTestVisible="False">
                        <ItemsControl ItemsSource="{Binding HourLabels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    <Setter Property="Canvas.Left" Value="10" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="White" FontSize="12" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>

                    <Canvas Grid.Column="1" ClipToBounds="True">
                        <Border Width="200"
                                Background="#22111111"
                                Visibility="{Binding ViewMode, Converter={StaticResource EnumEqualsToVisibilityConverter}, ConverterParameter=Compare}" />
                        <ItemsControl ItemsSource="{Binding HourLines}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    <Setter Property="Canvas.Left" Value="0" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="1" Width="440" Background="#FF444444" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding ScheduleBlocks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding Width}" Height="{Binding Height}" Background="{Binding Fill}" CornerRadius="5">
                                        <TextBlock Margin="10,5,10,5"
                                                   Text="{Binding Title}"
                                                   TextWrapping="Wrap"
                                                   FontSize="14"
                                                   Foreground="Black" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Canvas.Left="0"
                                Canvas.Top="{Binding NowLineY}"
                                Height="3"
                                Width="440"
                                Background="Red" />
                    </Canvas>
                </Grid>

                <Border Background="#FF2B2B2B"
                        Visibility="{Binding IsTodoVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TodoItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TodoItem}">
                                    <Grid Margin="12,6">
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="#FFBBBBBB"
                                                   FontSize="26"
                                                   FontWeight="Bold"
                                                   Visibility="{Binding Kind, Converter={StaticResource EnumEqualsToVisibilityConverter}, ConverterParameter=Section}" />

                                        <Border Background="#FF3A3A3A"
                                                CornerRadius="8"
                                                Padding="8"
                                                Visibility="{Binding Kind, Converter={StaticResource EnumEqualsToVisibilityConverter}, ConverterParameter=Task}">
                                            <TextBlock Text="{Binding Text}" Foreground="White" FontSize="22" TextWrapping="Wrap" />
                                        </Border>

                                        <Border Background="#FF2D2D2D"
                                                CornerRadius="6"
                                                Padding="4"
                                                Margin="20,0,0,0"
                                                Visibility="{Binding Kind, Converter={StaticResource EnumEqualsToVisibilityConverter}, ConverterParameter=Subtask}">
                                            <TextBlock Text="{Binding Text, StringFormat=↳ {0}}" Foreground="#FFCCCCCC" FontSize="20" TextWrapping="Wrap" />
                                        </Border>

                                        <Border Background="#FF2A2A2A"
                                                Padding="10"
                                                Visibility="{Binding Kind, Converter={StaticResource EnumEqualsToVisibilityConverter}, ConverterParameter=Info}">
                                            <TextBlock Text="{Binding Text}"
                                                       Foreground="#FFAAAAAA"
                                                       FontSize="26"
                                                       FontStyle="Italic"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Background="#A8000000"
                      Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="180">
                        <ProgressBar Height="10" IsIndeterminate="True" />
                        <TextBlock Margin="0,12,0,0"
                                   Text="Loading..."
                                   Foreground="White"
                                   FontSize="18"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border Background="#CC661111"
                        VerticalAlignment="Top"
                        Margin="16"
                        Padding="10"
                        CornerRadius="8"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StringHasValueToVisibilityConverter}}">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="White"
                               TextWrapping="Wrap"
                               FontSize="14" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
